{
  "id": "xfn-button-colleague-co-worker",
  "prerequisites": {
    "wordpress": "7.1.5",
    "php": "8.3",
    "theme": "twentytwentyfive",
    "themeVersion": "1.5",
    "plugins": {
      "link-extension-for-xfn": "1.1.3",
      "post-formats-for-block-themes": "1.1.12"
    }
  },
  "roles": [
    "administrator",
    "author"
  ],
  "operations": [
    "Use the button Inspector to clear Colleague and restore it, then save and reopen."
  ],
  "assertions": {
    "links": [
      {
        "url": "https://example.test/people/ferran-lark/",
        "selector": "a.wp-block-button__link[href=\"https://example.test/people/ferran-lark/\"]",
        "import": {
          "rel": [
            "colleague",
            "co-worker"
          ],
          "xfn": [
            "colleague",
            "co-worker"
          ],
          "other": []
        },
        "afterSave": {
          "rel": [
            "colleague",
            "co-worker"
          ]
        },
        "afterReload": {
          "xfn": [
            "colleague",
            "co-worker"
          ]
        },
        "render": {
          "rel": [
            "colleague",
            "co-worker"
          ]
        }
      }
    ]
  }
}
