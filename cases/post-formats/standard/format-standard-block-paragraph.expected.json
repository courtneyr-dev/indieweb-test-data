{
  "id": "format-standard-block-paragraph",
  "prerequisites": {
    "wordpress": "7.1.5",
    "php": "8.3",
    "theme": "twentytwentyfive",
    "themeVersion": "1.5",
    "plugins": {
      "link-extension-for-xfn": "1.1.3",
      "post-formats-for-block-themes": "1.1.12"
    }
  },
  "roles": [
    "administrator",
    "author"
  ],
  "operations": [
    "Open the imported post and confirm the selected format and content.",
    "Edit the post title, save, and reload.",
    "Confirm the format and content are preserved on reload and on the public single."
  ],
  "assertions": {
    "afterImport": {
      "term": null,
      "blocks": [
        "core/paragraph"
      ]
    },
    "afterReload": {
      "term": null,
      "blocks": [
        "core/paragraph"
      ],
      "valid": true
    },
    "render": {
      "selector": "p",
      "text": "The lantern walk begins at the east gate."
    }
  }
}
