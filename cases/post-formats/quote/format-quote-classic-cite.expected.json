{
  "id": "format-quote-classic-cite",
  "prerequisites": {
    "wordpress": "7.1.5",
    "php": "8.3",
    "theme": "twentytwentyfive",
    "themeVersion": "1.5",
    "plugins": {
      "link-extension-for-xfn": "1.1.3",
      "post-formats-for-block-themes": "1.1.12"
    }
  },
  "roles": [
    "administrator",
    "author"
  ],
  "operations": [
    "Edit the quote text in the code editor without converting the classic content. Save and reopen."
  ],
  "assertions": {
    "afterImport": {
      "term": "post-format-quote",
      "blocks": []
    },
    "afterReload": {
      "term": "post-format-quote",
      "blocks": [],
      "valid": true
    },
    "render": {
      "postClasses": [
        "format-quote",
        "pfbt-format-quote"
      ],
      "template": "Theme default with plugin format templates disabled."
    },
    "classic": {
      "selector": "blockquote > cite",
      "text": "Tavia Fen, Lantern Notes",
      "wrappedInBlock": false,
      "preservedAfterSave": true
    }
  }
}
